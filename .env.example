# Observability backend configuration
# Allowed values: dash0, jaeger

# The dash0 option will crash if the
# Dash0 credentials are not provided.

OBSERVABILITY_BACKEND=dash0

# If you would like to send data to Dash0,
# the following credentials are required.
# You can get them from your Dash0 account.
DASH0_AUTHORIZATION_TOKEN=<DASH0_AUTHORIZATION_TOKEN>
DASH0_ENDPOINT=<DASH0_GRPC_ENDPOINT>

# Disable SELinux when using Podman on MacOS to allow
# docker_stats to access the Podman socket
#OTEL_COLLECTOR_SELINUX_LABEL=disable

# DO NOT PUSH YOUR CREDENTIALS!
