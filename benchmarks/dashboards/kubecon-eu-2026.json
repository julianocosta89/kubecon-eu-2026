{
  "apiVersion": "perses.dev/v1alpha1",
  "kind": "PersesDashboard",
  "metadata": {
    "name": "kubecon-eu-2026"
  },
  "spec": {
    "display": {
      "name": "KubeCon EU - 2026",
      "description": "Container CPU and memory for the 6 song service variants, from the OTel Collector docker_stats receiver."
    },
    "duration": "1h",
    "variables": [],
    "panels": {
      "spring_cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container CPU usage",
            "description": "CPU cores used (rate of container.cpu.usage.total, ns/s ÷ 1e9)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "table",
                "values": [
                  "mean",
                  "max",
                  "last"
                ]
              },
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg by (container_name) (rate({otel_metric_name=\"container.cpu.usage.total\", container_name=~\"songs-spring-.*\"}[$__interval]) / 1e9)",
                    "seriesNameFormat": "{{container_name}}"
                  }
                }
              }
            }
          ]
        }
      },
